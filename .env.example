# AWS Configuration Template
# Copy this file to .env.local and fill in your credentials

# AWS Access Keys (from IAM console)
EXPO_PUBLIC_AWS_ACCESS_KEY_ID=your_access_key_id
EXPO_PUBLIC_AWS_SECRET_ACCESS_KEY=your_secret_access_key

# AWS Region
EXPO_PUBLIC_AWS_REGION=us-east-1

# CloudFront Configuration (optional, for signed URLs)
EXPO_PUBLIC_CLOUDFRONT_KEY_PAIR_ID=your_cloudfront_key_pair_id

# CloudFront Private Key (should be handled server-side in production)
# CLOUDFRONT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
